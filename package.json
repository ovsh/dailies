{
  "name": "dailies",
  "productName": "Dailies",
  "version": "0.5.3",
  "private": true,
  "description": "Chat with your footage. Local indexing, agent search, Avid-native export.",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --external:ffmpeg-static --external:ffprobe-static --external:electron-updater --define:__DAILIES_TELEMETRY_URL__=\"\\\"$DAILIES_TELEMETRY_URL\\\"\" --define:__DAILIES_TELEMETRY_TOKEN__=\"\\\"$DAILIES_TELEMETRY_TOKEN\\\"\" --outfile=dist-electron/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.cjs",
    "icon:mac": "node scripts/generate-app-icon.mjs",
    "native:node": "node scripts/manage-better-sqlite3.mjs node",
    "native:electron": "node scripts/manage-better-sqlite3.mjs electron",
    "predev": "npm run native:electron",
    "dev": "npm run build:main && concurrently -k \"vite\" \"VITE_DEV_SERVER_URL=http://localhost:5183 electron .\"",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run native:node",
    "test": "vitest run --root .",
    "e2e:onboarding": "node scripts/e2e-onboarding.mjs",
    "rebuild": "node scripts/manage-better-sqlite3.mjs electron --force",
    "predist": "npm run icon:mac && npm run native:electron",
    "dist": "npm run build:renderer && npm run build:main && electron-builder --mac"
  },
  "build": {
    "appId": "com.dailies.app",
    "productName": "Dailies",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "title": "Dailies"
    },
    "publish": {
      "provider": "github",
      "owner": "ovsh",
      "repo": "dailies"
    },
    "extraResources": [
      {
        "from": "vendor/whisper",
        "to": "whisper"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "png2icons": "^2.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "ws": "^8.21.0"
  }
}
