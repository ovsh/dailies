{
  "name": "dailies",
  "productName": "Dailies",
  "version": "0.1.0",
  "private": true,
  "description": "Chat with your footage. Local indexing, agent search, Avid-native export.",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --external:ffmpeg-static --external:ffprobe-static --outfile=dist-electron/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.cjs",
    "dev": "npm run build:main && concurrently -k \"vite\" \"VITE_DEV_SERVER_URL=http://localhost:5183 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build:renderer && npm run build:main && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.dailies.app",
    "productName": "Dailies",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Dailies"
    }
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
